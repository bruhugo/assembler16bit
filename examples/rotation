; This program rotates the bits of each register and output it


    MOV r0, 0b00000001
    MOV r1, 0b00000010
    MOV r2, 0b00000100
    MOV r3, 0b00001000
    MOV r4, 0b00010000
    MOV r5, 0b00100000
    MOV r6, 0b01000000
    MOV r7, 0b10000000

loop:
    CALL calc 
    JMP loop

calc:
    ROT r0, 1
    PUSH r0

    MOV r0, r1
    ROT r1, 1
    MOV r0, r2
    ROT r2, 1
    MOV r0, r3
    ROT r3, 1
    MOV r0, r4
    ROT r4, 1
    MOV r0, r5
    ROT r5, 1
    MOV r0, r6
    ROT r6, 1
    MOV r0, r7
    ROT r7, 1

    POP r0

    MOV out0, r0
    MOV out1, r1
    MOV out2, r2
    MOV out3, r3
    MOV out4, r4
    MOV out5, r5
    MOV out6, r6
    MOV out7, r7

    RET
